{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linxuan-garden-preview",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [{"name": "GARDEN_GATE", "class_name": "GardenGate"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["GardenGate"]}],
  "vars": {"DAILY_LIMIT": "20", "MAX_CONCURRENT": "2", "IMAGE_MODEL": "image-01"},
  "observability": {"enabled": false},
  "env": {
    "production": {
      "name": "linxuan-garden",
      "workers_dev": false,
      "routes": [
        {"pattern": "mehaifeng.fun/chenlinxuan", "zone_name": "mehaifeng.fun"},
        {"pattern": "mehaifeng.fun/chenlinxuan/*", "zone_name": "mehaifeng.fun"}
      ],
      "durable_objects": {
        "bindings": [{"name": "GARDEN_GATE", "class_name": "GardenGate"}]
      },
      "vars": {"DAILY_LIMIT": "20", "MAX_CONCURRENT": "2", "IMAGE_MODEL": "image-01"}
    }
  }
}
